{
  "manifest_version": 3,
  "name": "OpenJam e2e: foreign iframe extension",
  "version": "0.0.1",
  "description": "Test fixture. Injects one of its own chrome-extension:// pages as an iframe into every web page, the way password managers and grammar checkers do. Reproduces issue #48.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "key": ""
}
